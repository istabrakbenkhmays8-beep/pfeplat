# --- App ---
NEXT_PUBLIC_APP_NAME="Advancia Training"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Phase 2) ---
# Local Docker (default): docker compose up -d mongo
MONGODB_URI="mongodb://advancia:advancia_dev_pw@localhost:27017/advancia?authSource=admin"

# Compose credentials (used by docker-compose.yml)
MONGO_ROOT_USER="advancia"
MONGO_ROOT_PASSWORD="advancia_dev_pw"
MONGO_DB="advancia"

# mongo-express UI (http://localhost:8081)
ME_USER="admin"
ME_PASS="admin"

# --- Auth (Phase 3) ---
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Email (Phase 8) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Advancia Training <no-reply@advancia.tn>"
CONTACT_INBOX="contact@advancia.tn"

# --- Payments (Phase 6) ---
PAYMENT_PROVIDER="mock"   # mock | paymee | konnect | flouci
PAYMENT_PUBLIC_KEY=""
PAYMENT_SECRET_KEY=""

# --- AI (Phase 10) ---
AI_PROVIDER="groq"        # groq | anthropic
AI_API_KEY=""
AI_MODEL=""
